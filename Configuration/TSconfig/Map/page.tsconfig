# Page TSconfig of the partners map content element.
#
# Delivered by the set "fgtclb/academic-partners-map" and
# registered for the page field "Page TSconfig" by
# "Configuration/TCA/Overrides/pages.php" - one physical copy, two ways to it.
#
# The content element is hidden for the whole installation by
# "Configuration/page.tsconfig"; this file is what makes it selectable again,
# so it applies where the component is actually wanted instead of everywhere.
TCEFORM.tt_content.CType.removeItems := removeFromList(academicpartners_map)

mod.wizards.newContentElement.wizardItems.academic {
  elements {
    academicpartners_map {
      iconIdentifier = academic-partners
      title = LLL:EXT:academic_partners/Resources/Private/Language/locallang_be.xlf:plugin.partner_map.title
      description = LLL:EXT:academic_partners/Resources/Private/Language/locallang_be.xlf:plugin.partner_map.description
      tt_content_defValues {
        CType = academicpartners_map
      }
    }
  }

  # TYPO3 v12 gates every wizard element on this list: an element that is defined
  # but not named here is never added to the wizard
  # (NewContentElementController::getWizards()). TYPO3 v13 builds the wizard from
  # TCA instead (Feature: #102834) and ignores the key, so it is harmless there.
  # It belongs with the element definition above: both reach a page through the
  # same site set or the same "Page TSconfig" entry.
  show := addToList(academicpartners_map)
}
