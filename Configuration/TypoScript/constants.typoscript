plugin.tx_academicpartners {
  view {
    # cat=plugin.tx_academicpartners/file; type=string; label=Path to template root (FE)
    templateRootPath = EXT:academic_partners/Resources/Private/Templates/
    # cat=plugin.tx_academicpartners/file; type=string; label=Path to template partials (FE)
    partialRootPath = EXT:academic_partners/Resources/Private/Partials/
    # cat=plugin.tx_academicpartners/file; type=string; label=Path to template layouts (FE)
    layoutRootPath = EXT:academic_partners/Resources/Private/Layouts/
  }

  # Also a site setting of the set "fgtclb/academic-partners", with the same default -
  # see "Configuration/Sets/Full/settings.definitions.yaml".
  # cat=plugin.tx_academicpartners//a; type=boolean; label=Render the content element header in the plugins: only for a site whose content element layout renders no header
  renderContentElementHeader = 0

  # The page of the partner page type. Declared for site sets in
  # "Configuration/Sets/Full/settings.definitions.yaml" with the same default.
  page {
    # cat=plugin.tx_academicpartners/page; type=string; label=Page layout of partner pages: the Fluid layout the partner page renders its section "Main" into
    layout = Default
  }

  # Also a site setting of the set "fgtclb/academic-partners-list", with the same
  # default - see "Configuration/Sets/List/settings.definitions.yaml".
  pagination {
    # cat=plugin.tx_academicpartners/links; type=int+; label=Pagination: the most page numbers the partner list links at once (numbered pagination only)
    numberOfLinks = 5
  }

  # The category filters of the partner list and map. Also site settings of the set
  # "fgtclb/academic-partners", with the same defaults - see
  # "Configuration/Sets/Full/settings.definitions.yaml".
  filter {
    # cat=plugin.tx_academicpartners/filter; type=string; label=Filter types: comma-separated category type identifiers of the group "partners", in the order the filter form offers them; empty offers every type with categories
    categoryTypes =
    # cat=plugin.tx_academicpartners/filter; type=int+; label=Visible filters: how many filters are shown right away, the others behind "More filters"; 0 shows every filter
    visibleCount = 0
    # cat=plugin.tx_academicpartners/filter; type=boolean; label=Hide options without results: leave out the categories no listed partner carries instead of showing them disabled
    hideDisabledOptions = 0
    # cat=plugin.tx_academicpartners/filter; type=boolean; label=Active filter tags: one link per selected filter above the partner list and map, which removes that filter
    showActiveFilters = 0
    # cat=plugin.tx_academicpartners/filter; type=boolean; label=Reset link: a link back to the list or map as the content element presets it, shown while the visitor has filtered
    showReset = 0
    # cat=plugin.tx_academicpartners/filter; type=boolean; label=Result count: the number of partners found
    showResultCount = 0
  }

  # The partner map. Also site settings of the set "fgtclb/academic-partners-map", with the
  # same defaults, see "Configuration/Sets/Map/settings.definitions.yaml". They reach the map
  # module as data attributes of "#map", see "Partials/Partner/Map.html".
  map {
    # cat=plugin.tx_academicpartners/map; type=string; label=Centre latitude: the latitude the map is centred on while it shows no partner
    centerLatitude = 51.1657
    # cat=plugin.tx_academicpartners/map; type=string; label=Centre longitude: the longitude the map is centred on while it shows no partner
    centerLongitude = 10.4515
    # cat=plugin.tx_academicpartners/map; type=int+; label=Zoom without partners: the zoom level of the map while it shows no partner
    zoom = 6
    # cat=plugin.tx_academicpartners/map; type=int+; label=Maximum zoom: how far the map zooms in at most, also around a single partner
    maxZoom = 18
    # cat=plugin.tx_academicpartners/map; type=int+; label=Padding: the space in pixels between the edge of the map and the outermost partners
    padding = 50
    # cat=plugin.tx_academicpartners/map; type=string; label=Tile server URL: the URL template the map loads its tiles from
    tileUrl = https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
    # cat=plugin.tx_academicpartners/map; type=string; label=Attribution: the attribution the map shows for its tiles, as HTML
    attribution = &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors, Points &copy 2012 LINZ
  }
}
