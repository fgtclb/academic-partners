# Page TSconfig of this extension, auto-included for the whole installation.
#
# TYPO3 reads "Configuration/page.tsconfig" of every active extension since
# v12.0 (Feature: #96614). A site set does not replace that file, it adds to it
# for the sites that enable the set - so anything an installation needs
# regardless of its site configuration belongs here, not in the set.
#
# The backend layout in particular: it is the layout of the page type this
# extension registers, so a page carrying "pagets__AcademicPartner" has to find
# it on every installation. Registered only in the set, the value resolves
# nowhere, the page properties show "[ MISSING LABEL ]" for it and the layout
# cannot be selected for a new page at all.
@import 'EXT:academic_partners/Configuration/TsConfig/BackendLayouts/*.tsconfig'
@import 'EXT:academic_partners/Configuration/TsConfig/Wizards/*.tsconfig'

# Register `EXT:backend` template overrides in backend context
templates.typo3/cms-backend.academic-partners = fgtclb/academic-partners:Resources/Private/Backend
